---
import Base from "../layouts/Base.astro"
import Card from "./Card.astro"
import { t, type Lang, entriesLabel } from "../lib/site"
import { folderItems, noteUrl, factionOf, thumb, type Folder } from "../lib/notes"
import { ART } from "../lib/universe"

const { folder } = Astro.props as { folder: Folder }
const lang = folder.lang as Lang
const s = t(lang)
const items = await folderItems(folder)
const parts = folder.id.split("/")
const crumbs = parts.slice(0, -1).map((_, i) => parts.slice(0, i + 1).join("/")).filter((id) => id !== "en" && id !== "de")
const top = parts[parts.length === 1 ? 0 : lang === "uk" ? 0 : 1]
const inner = parts.length - (lang === "uk" ? 0 : 1)
const lead = inner > 1 ? undefined : /^(Books)$/.test(top) ? s.booksLead : /^(Всесвіт|Universe)$/.test(top) ? s.codexLead : undefined
const faction = factionOf(folder.id)
const art = items.find((i) => i.image)?.image ?? ART.hero
const active = top === "Books" ? "books" : /Ігри|Games|Spiele/.test(top) ? "games" : "codex"
---
<Base title={folder.name} description={lead ?? `${folder.name} — ${entriesLabel(lang, items.length)}`} lang={lang} faction={faction} active={active} image={`/og/${folder.id}.jpg`}>
  <header class="f-hero">
    <img src={thumb(art, 1280)} alt="" />
    <div class="wrap">
      <nav class="mono crumbs">{crumbs.map((c) => <><a href={noteUrl(c)}>{c.split("/").pop()!.replace(/-/g, " ")}</a><span>/</span></>)}</nav>
      <p class="label">{s.codex} · {entriesLabel(lang, items.length)}</p>
      <h1 class="display">{folder.name}</h1>
      {lead && <p class="sub">{lead}</p>}
    </div>
  </header>
  <section class="wrap list">
    <div class="grid">
      {items.map((i, k) => <Card href={i.href} title={i.title} image={i.image} text={i.text} kicker={i.folder ? `▸ ${entriesLabel(lang, i.count)}` : undefined} faction={i.faction} folder={i.folder} eager={k < 4} />)}
    </div>
  </section>
</Base>
<style>
  .f-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .f-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.45; filter: saturate(0.8); }
  .f-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--void), rgba(3, 5, 11, 0.4)), linear-gradient(90deg, rgba(3, 5, 11, 0.9), transparent); }
  .f-hero .wrap { position: relative; z-index: 1; padding: 100px 0 40px; }
  .crumbs { display: flex; gap: 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 14px; }
  .crumbs span { color: var(--muted); }
  h1 { font-size: clamp(32px, 5vw, 64px); text-transform: uppercase; margin-top: 12px; }
  .sub { color: var(--dim); font: 18px/1.6 var(--read); max-width: 680px; margin: 16px 0 0; }
  .list { padding-top: 44px; }
</style>
