---
// Generated faction poster for empires that have no artwork yet.
interface Props { kind: "corp" | "sun" | "hetman" | "deck" | "europa" }
const { kind } = Astro.props
const rays = Array.from({ length: 24 }, (_, i) => (i * 360) / 24)
const hexes = Array.from({ length: 7 * 5 }, (_, i) => ({ x: (i % 7) * 52 + ((Math.floor(i / 7) % 2) * 26), y: Math.floor(i / 7) * 45 }))
---
<svg class="sigil" viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id={`g-${kind}`} cx="50%" cy="55%" r="65%">
      <stop offset="0" stop-color={kind === "sun" ? "#ffb347" : "#ff5a78"} stop-opacity=".55" />
      <stop offset=".45" stop-color={kind === "sun" ? "#ff6a00" : "#5b1230"} stop-opacity=".35" />
      <stop offset="1" stop-color="#03050b" />
    </radialGradient>
  </defs>
  <rect width="320" height="200" fill={`url(#g-${kind})`} />
  {kind === "sun" ? (
    <g transform="translate(160 110)">
      {rays.map((a, i) => <rect x="-1.5" y={i % 2 ? -96 : -118} width="3" height={i % 2 ? 40 : 58} fill="#ffd75e" opacity={i % 2 ? 0.35 : 0.6} transform={`rotate(${a})`} />)}
      <circle r="44" fill="#ff8f1f" opacity=".9" />
      <circle r="44" fill="none" stroke="#ffe08a" stroke-width="2" />
      <circle r="30" fill="none" stroke="#fff3c4" stroke-width="1" opacity=".7" />
      <circle r="14" fill="#fff3c4" />
    </g>
  ) : (
    <g>
      <g transform="translate(-6 -10)" stroke="#ff4d6d" stroke-opacity=".28" fill="none">
        {hexes.map((h) => <path d={`M${h.x + 26} ${h.y} l22 13 v26 l-22 13 l-22 -13 v-26 z`} />)}
      </g>
      <g transform="translate(160 105)">
        <path d="M0 -58 L50 -29 V29 L0 58 L-50 29 V-29 Z" fill="#14070d" stroke="#ff4d6d" stroke-width="2.5" />
        <path d="M0 -36 L31 -18 V18 L0 36 L-31 18 V-18 Z" fill="none" stroke="#c9d6ea" stroke-width="1.5" />
        <path d="M-18 -6 h36 M-18 6 h36 M0 -24 v48" stroke="#c9d6ea" stroke-width="3" />
        <circle r="5" fill="#ff4d6d" />
      </g>
    </g>
  )}
</svg>
<style>
  .sigil { width: 100%; height: 100%; display: block; }
</style>
